# URL do site em produção
NEXT_PUBLIC_SITE_URL=https://focoemia.com.br

# Google Analytics 4 — adicione após criar propriedade no Google Analytics
# Formato: G-XXXXXXXXXX
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Google Search Console — adicione o token de verificação fornecido pelo Google
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Google AdSense — adicione após aprovação da conta no AdSense
# Formato: ca-pub-XXXXXXXXXXXXXXXXXX
NEXT_PUBLIC_ADSENSE_CLIENT=

# Slots de anúncio do AdSense — crie os slots no painel do AdSense
NEXT_PUBLIC_ADSENSE_SLOT_ARTICLE_TOP=
NEXT_PUBLIC_ADSENSE_SLOT_IN_CONTENT=
NEXT_PUBLIC_ADSENSE_SLOT_SIDEBAR=
